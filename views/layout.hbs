<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8">
    <title>Quản lý Sách</title>
    <style>
        body {
            font-family: sans-serif;
            max-width: 820px;
            margin: 24px auto;
        }

        table {
            border-collapse: collapse;
            width: 100%;
        }

        th,
        td {
            border: 1px solid #ccc;
            padding: 8px;
            text-align: left;
        }

        footer {
            margin-top: 32px;
            padding-top: 12px;
            border-top: 1px solid #ccc;
        }

        .error {
            color: #a40000;
        }
    </style>
</head>

<body>
    {{{body}}}
    <footer>
        <p>Họ tên: {{hoTen}}</p>
        <p>MSSV: {{mssv}}</p>
        <p>Mức VAT áp dụng: {{vat}}%</p>
    </footer>
</body>

</html>